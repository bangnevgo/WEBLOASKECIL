# =============================================================================
# WEBLOASKECIL — Environment Configuration Template
# Copy this file to .env and fill in your credentials
# =============================================================================

# Database (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# AI & LLM Inference Providers (/api/ai & src/lib/ai-providers.ts)
ZAI_BASE_URL="https://api.example.com/v1"
ZAI_API_KEY="your_zai_api_key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY="your_openrouter_api_key"
OPENROUTER_MODEL="openrouter/auto"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Google Analytics 4 (Client Tracking & Server-side Data API v1beta)
NEXT_PUBLIC_GA_ID="G-C8N91XC6NL"
GA4_PROJECT_ID="your_gcp_project_id"
GA4_SERVICE_ACCOUNT_EMAIL="service-account@your-project.iam.gserviceaccount.com"
GA4_PRIVATE_KEY_ID="your_private_key_id"
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Search Console API (/api/analytics/gsc)
GSC_CLIENT_ID="your_oauth_client_id"
GSC_CLIENT_SECRET="your_oauth_client_secret"
GSC_REFRESH_TOKEN="your_oauth_refresh_token"

# Google Calendar & Meet Booking Integration
GOOGLE_CALENDAR_ID="primary"

# Payment Gateway (Midtrans Snap & Lynk.id Webhook)
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SERVER_KEY="SB-Mid-server-xxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxx"
LYNK_MERCHANT_KEY="your_lynk_merchant_key"

# Lead Pipeline & Notifications
GOOGLE_SHEET_URL="https://script.google.com/macros/s/xxx/exec"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_ADMIN_CHAT_ID="your_telegram_chat_id"

# Access Control & Media CDN
ADMIN_ACCESS_KEY="your_admin_access_key"
PUBLIC_ACCESS_KEY="your_public_access_key"
BUNNY_CDN_URL="https://your-zone.b-cdn.net"
BUNNY_SECURITY_KEY="your_bunny_security_key"
